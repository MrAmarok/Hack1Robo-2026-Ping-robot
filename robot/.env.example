# Copie en robot/.env (ignore par git). robot.js le charge au demarrage.
# Une variable passee en ligne de commande ou par le service systemd reste
# prioritaire sur ce fichier.

# --- Serveur (requis) ---
SERVER_URL=http://<ip-ou-domaine-du-serveur>:3000

# --- Appairage ---
# CODE=123456
# Meme valeur que ROBOT_KEY du serveur, si elle y est configuree.
# ROBOT_KEY=

# --- Video WebRTC (publication RTSP vers MediaMTX) ---
# Mot de passe de publication (VPS : /opt/mediamtx/publish-pass.txt).
# Vide = pas de video WebRTC, le robot reste en MJPEG de secours.
RTC_PASS=
# RTC_USER=robot
# RTC_HOST=            # defaut : la machine de SERVER_URL
# RTC_PORT=3002
# RTC_PUSH_URL=        # URL rtsp:// complete, prioritaire sur les 4 champs ci-dessus

# --- Cle 4G (interface HiLink) ---
# RTC_MODEM_API=http://192.168.8.1
