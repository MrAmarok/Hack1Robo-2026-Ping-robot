# Copie en mobile/.env (ignore par git). Expo le charge avant app.config.js.
#
# Pour les builds EAS, ce fichier n'est PAS televerse : declare la meme
# variable cote EAS (eas env:create --name GOOGLE_MAPS_API_KEY ...).

# Cle Google Maps (SDK Android + iOS). A restreindre dans la console Google
# Cloud au paquet / bundle com.andya.ping.
GOOGLE_MAPS_API_KEY=

# Optionnel : serveur Ping local pour le developpement (sinon la production).
# EXPO_PUBLIC_PING_SERVER_ORIGIN=http://localhost:8000
