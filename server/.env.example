# Copie en server/.env (en prod : /root/server/.env). Tout est optionnel :
# sans cle, la fonction correspondante s'annonce inactive au demarrage.

# --- Serveur ---
PORT=3000
PUBLIC_URL=https://api.ping-app.org
ROBOT_DEBUG_LOGS=false

# --- MediaMTX (video/audio WebRTC, en local sur le VPS) ---
# MTX_HOST=127.0.0.1
# MTX_HTTP_PORT=8889
# MTX_USER=robot
# MTX_PASS=            # sinon lu dans /opt/mediamtx/publish-pass.txt

# --- Fichiers persistants (defauts = emplacements du VPS) ---
# ALERTES_DIR=/root/server/alertes
# ALERTES_FICHIER=/root/server/alertes.json
# PUSH_FICHIER=./push-tokens.json
# REC_DIR=/root/enregistrements
# REC_RTSP=rtsp://127.0.0.1:3002
# REC_MAX_MS=900000

# --- Alertes ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# ALERTES_GARDEES=60
# CADENCE_PERSONNE=30000
# CADENCE_ANIMAL=900000
# CADENCE_RIEN=900000

# --- Assistant vocal "Hey Solana" ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# VOICE_MODEL=claude-opus-5
# VISION_MODEL=claude-haiku-4-5-20251001
# VOICE_EFFORT=low
# VOICE_FAST=false
# OWNER_NAME=Andy
# DEEPGRAM_MODEL=nova-3
# WHISPER_BIN=/root/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/root/whisper.cpp/models/ggml-small-q5_1.bin

# --- Conversation en direct (OpenAI Realtime) ---
OPENAI_API_KEY=
# REALTIME_MODEL=
# REALTIME_VOICE=

# --- Appels Twilio (personne vue sur une alerte) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERTE_APPEL_NUMERO=
# ALERTE_APPEL_CADENCE_MS=
# PROCHE_NOM=
# PROCHE_NUMERO=
# ADRESSE_MAISON=
